# SEO canonical redirects for legacy/main service URLs
# Keep established root URLs as the single indexable versions.

RewriteEngine On

# Remove Yandex Metrika debug parameter from the homepage URL.
# Example: /?_ym_debug=1 -> /
RewriteCond %{QUERY_STRING} (^|&)_ym_debug=[^&]*(&|$) [NC]
RewriteRule ^$ / [R=301,L,QSD]

# Canonical URL for the homepage without editing the large index.html.
# Yandex supports rel=canonical in an HTTP Link header.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/$" IS_HOME=1
  Header set Link "<https://ohrana.tech/>; rel=\"canonical\"" env=IS_HOME
</IfModule>

# Legacy article URL -> current canonical article.
Redirect 301 /kompleksnaja-ohrana/ https://ohrana.tech/stati/kompleksnaya-ohrana.html
Redirect 301 /stati/nochnaya-ohrana.html https://ohrana.tech/stati/nochnaya-ohrana-obektov.html
Redirect 301 /stati/ohrana-meropriyatiy-v-moskve.html https://ohrana.tech/ohrana-meropriyatiy-v-moskve/
Redirect 301 /soprovozhdenie-gruzov/ https://ohrana.tech/stati/soprovozhdenie-gruzov.html

Redirect 301 /uslugi/ohrana-skladov/ https://ohrana.tech/ohrana-skladov/
Redirect 301 /uslugi/ohrana-magazinov/ https://ohrana.tech/ohrana-magazinov/
Redirect 301 /uslugi/ohrana-ofisov/ https://ohrana.tech/ohrana-ofisov/
Redirect 301 /uslugi/ohrana-torgovyh-centrov/ https://ohrana.tech/ohrana-torgovyh-centrov/
Redirect 301 /uslugi/ohrana-biznes-centrov/ https://ohrana.tech/ohrana-biznes-centrov/
Redirect 301 /uslugi/ohrana-gostinic/ https://ohrana.tech/ohrana-gostinic/
Redirect 301 /uslugi/ohrana-avtosalonov/ https://ohrana.tech/ohrana-avtosalonov/
Redirect 301 /uslugi/ohrana-restoranov/ https://ohrana.tech/ohrana-restoranov/
Redirect 301 /uslugi/ohrana-parkovok/ https://ohrana.tech/ohrana-parkovok/
Redirect 301 /uslugi/ohrana-stroitelnyh-obektov/ https://ohrana.tech/ohrana-stroitelnyh-obektov/
